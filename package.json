{
  "name": "personal-ai-radio",
  "version": "0.1.2",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n server,web -c amber,cyan \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:web": "vite",
    "build": "tsc -b && vite build",
    "build:showcase": "tsc -b && vite build --config vite.showcase.config.ts",
    "dev:showcase": "npm run build:showcase && vite preview --config vite.showcase.config.ts --host 127.0.0.1 --port 5176",
    "showcase:validate": "tsx scripts/showcase/validate-cli.ts",
    "showcase:validate:release": "tsx scripts/showcase/validate-cli.ts --release",
    "showcase:scan-build": "tsx scripts/showcase/scan-build.ts",
    "showcase:release-check": "npm run showcase:validate:release && npm run build:showcase && npm run showcase:scan-build",
    "showcase:import": "vite --config vite.import.config.ts --host 127.0.0.1 --port 4174 --open",
    "start": "node dist-server/index.js",
    "preview": "vite preview",
    "scan": "tsx server/scripts/scan.ts",
    "smoke": "tsx server/scripts/smoke.ts",
    "dj:model-first-quality": "tsx server/scripts/dj-model-first-quality.ts",
    "dj:model-first-minimal-quality": "tsx server/scripts/dj-model-first-quality.ts --minimal",
    "dj:random-five": "tsx server/scripts/dj-random-five.ts",
    "dj:fewshot-selected-five": "tsx server/scripts/dj-fewshot-selected-five.ts",
    "kugou:playback": "tsx server/scripts/kugou-playback-quality.ts"
  },
  "dependencies": {
    "express": "^5.2.1",
    "gsap": "^3.15.0",
    "lucide-react": "^0.561.0",
    "motion": "^12.42.2",
    "ogl": "^1.0.11",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "three": "^0.185.1",
    "undici": "^8.9.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.10.2",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.185.1",
    "@vitejs/plugin-react": "^5.1.1",
    "concurrently": "^9.2.1",
    "music-metadata": "^11.8.3",
    "tsx": "^4.23.7",
    "typescript": "^5.9.3",
    "vite": "^7.3.5"
  }
}
