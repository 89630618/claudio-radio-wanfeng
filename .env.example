AI_PROVIDER=openai
AI_BASE_URL=https://tokenflux.dev/v1
AI_API_KEY=
AI_MODEL=gpt-5.6-terra
DJ_AI_MODEL=gpt-5.6-terra
CHAT_AI_PROVIDER=deepseek
CHAT_AI_BASE_URL=https://api.deepseek.com/v1
CHAT_AI_API_KEY=
CHAT_AI_MODEL=deepseek-v4-flash
DJ_AI_TEMPERATURE=0.85
DJ_AI_TIMEOUT_MS=30000
DJ_AI_REASONING_EFFORT=medium
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.2
PORT=3080
CLAUDIO_HOST=127.0.0.1
DATA_DIR=.data
USER_PROFILE_DIR=.data/user
WEATHER_CITY=上海
WEATHER_LATITUDE=31.2304
WEATHER_LONGITUDE=121.4737
FISH_TTS_API_KEY=
